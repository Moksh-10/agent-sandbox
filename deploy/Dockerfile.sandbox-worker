FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /sandbox-worker ./cmd/sandbox-worker

FROM alpine:3.20
RUN apk add --no-cache ca-certificates grep
WORKDIR /workspace
COPY --from=build /sandbox-worker /sandbox-worker
EXPOSE 9090
ENTRYPOINT ["/sandbox-worker"]
